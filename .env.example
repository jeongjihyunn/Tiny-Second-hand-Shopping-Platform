# Copy this file to .env and fill in real values before running the app.
# NEVER commit the real .env file.

# Long, random, unpredictable string used to sign session cookies & CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-random-64-char-hex-string

# Set to "production" to enable strict cookies (Secure flag) - requires HTTPS.
FLASK_ENV=development

# SQLite file location (relative to project root)
DATABASE_URL=sqlite:///instance/app.db

# Number of reports before a product is auto-hidden / a user is auto-suspended
REPORT_THRESHOLD=5

# Starting point balance given to newly registered users (demo "wallet" points, not real money)
SIGNUP_BONUS_BALANCE=100000
